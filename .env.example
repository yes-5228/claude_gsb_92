# 排水管网清淤记录系统 —— 环境变量样例
#
# 使用方式：复制为 .env 后按需修改，docker compose 会自动读取；
# 直接本地运行后端时，也可以自行设置这些变量。

# ---------- 对外端口 ----------
BACKEND_PORT=8080
FRONTEND_PORT=8081

# ---------- PostgreSQL ----------
POSTGRES_DB=desilting
POSTGRES_USER=desilting
POSTGRES_PASSWORD=desilting123456

# ---------- 后端运行参数 ----------
# APP_ENV: development / production
APP_ENV=production
# 是否写入演示数据（仅当数据表为空时写入）
APP_SEED_ENABLED=true
# 日志级别：debug / info / warn / error
APP_LOG_LEVEL=info
